{
    "name": "zippendo/zippendo-php",
    "description": "Official PHP SDK for the Zippendo shipping API: book shipments, print labels and track parcels with PostNord, GLS, DAO, Bring, DHL, DPD, UPS and more.",
    "keywords": [
        "zippendo",
        "shipping",
        "shipping-api",
        "shipping-labels",
        "logistics",
        "parcel",
        "tracking",
        "ecommerce",
        "fulfillment",
        "postnord",
        "gls",
        "dao",
        "bring",
        "dhl",
        "dpd",
        "ups",
        "sdk",
        "api-client"
    ],
    "homepage": "https://www.zippendo.com/docs/sdks/overview",
    "license": "MIT",
    "authors": [
        {
            "name": "Zippendo",
            "email": "support@zippendo.com",
            "homepage": "https://www.zippendo.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Zippendo\\Sdk\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zippendo\\Sdk\\Test\\": "test/"
        }
    },
    "support": {
        "email": "support@zippendo.com",
        "docs": "https://www.zippendo.com/docs/sdks/overview",
        "issues": "https://github.com/zippendo/zippendo-php/issues",
        "source": "https://github.com/zippendo/zippendo-php"
    }
}
